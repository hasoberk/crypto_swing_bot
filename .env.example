# Sırlar. Bu dosyayı `.env` olarak kopyala ve doldur. `.env` .gitignore'dadır.
#
# EXCHANGE_API_KEY / EXCHANGE_API_SECRET: yalnızca okuma + spot işlem yetkisi
# olan bir API anahtarı kullan. ÇEKİM (withdrawal) yetkisi KAPALI olmalı
# (SPEC.md İ8, Bölüm 13). mode: live için zorunludur.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# TELEGRAM_BOT_TOKEN: @BotFather'dan alınan token.
# TELEGRAM_CHAT_ID: yalnızca bu chat'ten gelen komutlar kabul edilir
# (config.yaml'daki telegram.allowed_chat_id bunu override eder).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
